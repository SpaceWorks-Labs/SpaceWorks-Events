{
  "name": "spaceworks-events",
  "version": "0.11.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:e2e": "playwright test",
    "test:e2e:production": "node scripts/prepare-standalone.mjs && PLAYWRIGHT_PRODUCTION_SERVER=1 playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma.mjs migrate dev",
    "db:deploy": "node --env-file-if-exists=.env scripts/prisma.mjs migrate deploy",
    "db:status": "node --env-file-if-exists=.env scripts/prisma.mjs migrate status",
    "db:verify": "node scripts/verify-production-schema.mjs",
    "db:backup": "node --env-file-if-exists=.env scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "storage:migrate": "node scripts/migrate-assets-to-s3.mjs",
    "db:push": "node --env-file-if-exists=.env scripts/prisma.mjs db push",
    "db:studio": "node --env-file-if-exists=.env scripts/prisma.mjs studio",
    "production:check": "node scripts/check-production-env.mjs",
    "brand:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-brand-assets.ts",
    "readme:art": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-readme-art.ts",
    "frontend:catalog": "node scripts/generate-frontend-catalog.mjs",
    "help:index": "node scripts/generate-help-index.mjs",
    "help:screenshots": "playwright test -c tests/help-screenshots/playwright.config.ts",
    "frontend:prepare": "node scripts/prepare-frontend.mjs",
    "build:frontend": "npm run build --workspace=frontend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "test:e2e:split": "node scripts/test-split-hosting.mjs",
    "test:e2e:vps": "node scripts/test-split-hosting.mjs --monolith"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@aws-sdk/client-s3": "^3.1116.0",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.4.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "@tiptap/react": "^3.30.5",
    "@tiptap/starter-kit": "^3.30.5",
    "@types/mdx": "2.0.14",
    "@types/sanitize-html": "^2.16.1",
    "bcryptjs": "^3.0.3",
    "clsx": "2.1.1",
    "framer-motion": "^13.1.0",
    "html5-qrcode": "^2.3.8",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "lucide-react": "1.49.0",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "10.2.1",
    "otpauth": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-qr-code": "^2.0.18",
    "remark-gfm": "4.0.1",
    "rrule": "^2.8.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "3.7.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/ioredis": "^4.28.10",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "fontkit": "2.0.4",
    "js-yaml": "^4.3.2",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.11.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "workspaces": [
    "frontend"
  ]
}
