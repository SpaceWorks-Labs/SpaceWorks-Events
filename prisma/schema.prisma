  speakerId      String
  sortOrder      Int @default(0)

  session EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  speaker EventSpeaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  @@id([eventSessionId, speakerId])
