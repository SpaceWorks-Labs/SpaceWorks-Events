  eventId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions EventSession[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

model EventSession {
