  sortOrder    Int                @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions EventSessionSpeaker[]
  @@unique([eventId, slug])
  @@index([eventId, sortOrder])
}

model EventSessionSpeaker {
