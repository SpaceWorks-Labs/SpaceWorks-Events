generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries use DATABASE_URL, which may be a transaction pooler
  // (Supabase Supavisor :6543 with ?pgbouncer=true). Migrations need a direct
  // or session-mode connection, so Prisma CLI uses DIRECT_URL. Set it equal to
  // DATABASE_URL when there is no pooler (local development, CI).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum EventPermission {
  EDIT_DETAILS
  MANAGE_REGISTRATIONS
  MANAGE_INVITATIONS
  CHECK_IN
  PUBLISH_AND_SCHEDULE
  /// Hackathon judging workspace only (docs/HACKATHON.md). A collaborator with
  /// just this grant sees no guests, answers, emails, check-in, or editing.
  JUDGE
}

enum EventStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  CANCELLED
}

enum EventPageSectionType {
  HERO
  ABOUT
  HIGHLIGHTS
  SCHEDULE
  SPEAKERS
  SPONSORS
  VENUE
  FAQ
  RESOURCES
}

enum ContentVisibility {
  DRAFT
  PUBLISHED
  HIDDEN
}

enum SponsorTier {
  PLATINUM
  GOLD
  SILVER
  PARTNER
  COMMUNITY_PARTNER
}

enum EventPrivacyType {
  PUBLIC
  HIDDEN_LINK
  APPROVAL_REQUIRED
  INVITE_ONLY
}

enum RsvpStatus {
  CONFIRMED
  WAITLISTED
  PENDING_APPROVAL
  REJECTED
  /// A paid ticket whose seat is held until `holdExpiresAt` while its order is paid.
  PENDING_PAYMENT
}

enum RegistrationFieldType {
  TEXT
  TEXTAREA
  EMAIL
  PHONE
  SELECT
  MULTI_SELECT
  RADIO
  CHECKBOX
  NUMBER
  DATE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

enum ApiClientStatus {
  ACTIVE
  DISABLED
}

enum BroadcastAttendanceFilter {
  ANY
  CHECKED_IN
  NOT_CHECKED_IN
}

/// How people register for a one-off event. TEAM events count capacity in
/// registration units (a team or a solo registrant); see docs/TEAMS.md.
enum RegistrationMode {
  INDIVIDUAL
  TEAM
}

/// Whether a TEAM event accepts registrations without a team, and whether
/// solo registrants may list themselves as looking for a team.
enum SoloPolicy {
  TEAMS_ONLY
  SOLO_ALLOWED
  SOLO_WITH_MATCHING
}

/// Who pays on a TEAM event that sells tickets (docs/TEAMS.md).
enum TeamTicketMode {
  /// Everyone buys their own ticket: the leader when creating the team, members when joining.
  PER_MEMBER
  /// The leader buys one ticket for the whole team; members join free.
  PER_TEAM
}

/// INVITE: a team leader invited a seeker. REQUEST: a seeker asked to join.
enum TeamJoinRequestDirection {
  INVITE
  REQUEST
}

enum TeamJoinRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Lifecycle of a hackathon project (docs/HACKATHON.md). Only SUBMITTED
/// projects can be scored or win an award.
enum SubmissionStatus {
  DRAFT
  SUBMITTED
  WITHDRAWN
  DISQUALIFIED
}

/// Judges can score only while OPEN. CLOSED freezes scores. The rubric can be
/// changed only while NOT_STARTED.
enum JudgingStatus {
  NOT_STARTED
  OPEN
  CLOSED
}

/// How judges' result scores are combined (docs/HACKATHON.md).
/// RAW: plain mean of judges' scores. ZSCORE: each judge's scores are
/// standardised before averaging, to correct for harsh or lenient judges.
enum ScoreNormalization {
  RAW
  ZSCORE
}

/// A judging round's lifecycle (docs/HACKATHON.md "Rounds"). At most one
/// round of an event is OPEN (partial unique index). DRAFT rounds can still
/// change their rubric and entries; CLOSED freezes scores.
enum JudgingRoundStatus {
  DRAFT
  OPEN
  CLOSED
}

/// Which projects a round judges: every SUBMITTED project, or only those
/// advanced into it from the previous round (JudgingRoundEntry).
enum JudgingRoundEntrySource {
  ALL_SUBMITTED
  ADVANCED
}

/// How an automatic assignment run picks judges: BALANCED breaks ties with a
/// fixed hash; RANDOM with a crypto-random seed stored on the run, so the
/// same seed and inputs always give the same plan.
enum JudgeAssignmentStrategy {
  BALANCED
  RANDOM
}

/// Which paged event-dashboard list a saved view filters (Saved views in
/// docs/FEATURES.md). Each surface has its own allow-list in lib/savedViews.ts.
enum SavedViewSurface {
  GUESTS_PEOPLE
  GUESTS_TEAMS
  JUDGING_SUBMISSIONS
  JUDGING_RESULTS
  JUDGING_PROGRESS
}

enum OrderStatus {
  /// A paid request waiting for approval or a waitlist place; nothing is held or charged.
  REQUESTED
  /// Waiting for payment while its seats are held.
  PENDING
  /// Paid, free, or settled by hand: its tickets are issued.
  CONFIRMED
  /// The hold ended unpaid.
  EXPIRED
  /// Declined before payment, or cancelled (and refunded) afterwards.
  CANCELLED
}

/** A chargeback, as the payment provider reports it. */
enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
  CLOSED
}

/** Who can see and buy a ticket type. */
enum TicketVisibility {
  PUBLIC
  /// Hidden until the buyer enters its access code.
  CODE
  /// Only signed-in members of the organisation.
  MEMBERS
}

/** A fixed price, or pay what you want from the price upwards. */
enum TicketPricing {
  FIXED
  FLEXIBLE
}

enum OrderLineKind {
  TICKET
  ADD_ON
  FEE
}

enum PaymentStatus {
  PENDING
  PAID_ONLINE
  PAID_OFFLINE
  WAIVED
  CANCELED
  EXPIRED
}

enum CheckoutAttemptStatus {
  OPEN
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// How an organiser collected money by hand.
enum OfflinePaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD_TERMINAL
  OTHER
}

enum PromoDiscountKind {
  PERCENT
  FIXED
}

enum PromoAppliesPer {
  TICKET
  ORDER
}

/// What attendees get back if they cancel a paid ticket themselves.
/// A ticket for one event or one date of a series, or a pass for every remaining date.
enum TicketTypeKind {
  SINGLE
  PASS
}

enum RefundPolicyKind {
  /// The organiser handles refunds.
  NONE
  /// A full refund until `refundPolicyHours` before the start.
  FULL_UNTIL
  /// `refundPolicyPercent` back until `refundPolicyHours` before the start.
  PERCENT_UNTIL
}

/// Who collected a payment. Organisations connect RAZORPAY or STRIPE; OFFLINE
/// marks money an organiser recorded by hand and is never a settings choice.
enum PaymentProvider {
  RAZORPAY
  STRIPE
  OFFLINE
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  /// User-selected profile image. Provider images remain in `image` as a fallback.
  profileImageUrl    String?
  /// Bcrypt hash for email + password credential logins. Null for OAuth-only users.
  passwordHash       String?
  /// Incremented to invalidate all issued JWT sessions after account recovery.
  sessionVersion     Int       @default(0)
  /// AES-GCM encrypted TOTP seed. Never expose or log this value.
  mfaSecretEncrypted String?
  mfaEnabledAt       DateTime?
  recoveryCodeHashes String[]  @default([])
  createdAt          DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  devices           UserDevice[]
  memberships       Membership[]
  rsvps             RSVP[]
  orgInvitesCreated OrganisationInvite[] @relation("OrgInviteCreatedBy")
  orgInvitesUsed    OrganisationInvite[] @relation("OrgInviteUsedBy")
  auditEvents       AuditEvent[]
  checkInEvents     CheckInEvent[]
  rsvpDeletionUndos RsvpDeletionUndo[]
  eventCollaborations EventCollaborator[]
  eventCollaboratorInvitesUsed EventCollaboratorInvite[] @relation("EventCollaboratorInviteUsedBy")
  eventBroadcasts   EventBroadcast[]
  broadcastDrafts   EventBroadcastDraft[]
  badgeDesignsUpdated EventBadgeDesign[]
  idMemberships     IdMember[]
  orders            Order[]           @relation("OrderBuyer")
  paymentRefunds    PaymentRefund[]
  paymentsSettled   Payment[]          @relation("PaymentSettledBy")
  paymentAmendments PaymentAmendment[] @relation("PaymentAmendmentActor")
  promoCodesCreated PromoCode[]        @relation("PromoCodeCreatedBy")
  checkInListRecords CheckInListRecord[]
  checkInListEvents  CheckInListEvent[]
  webhookEndpointsCreated WebhookEndpoint[] @relation("WebhookEndpointCreatedBy")
  judgeAssignments             JudgeAssignment[]
  judgeScores                  JudgeScore[]
  judgeReviews                 JudgeReview[]
  judgingRoundPanels           JudgingRoundJudge[]
  judgingRoundEntriesAdvanced  JudgingRoundEntry[] @relation("JudgingRoundEntryAdvancedBy")
  judgingAssignmentRuns        JudgingAssignmentRun[] @relation("JudgingAssignmentRunBy")
  savedViews                   SavedView[]
  prizePayoutsRecorded         PrizePayout[] @relation("PrizePayoutRecordedBy")
  expenseClaimsSubmitted       ExpenseClaim[] @relation("ExpenseClaimSubmittedBy")
  expenseClaimsDecided         ExpenseClaim[] @relation("ExpenseClaimDecidedBy")
  claimPayoutsRecorded         ClaimPayout[]  @relation("ClaimPayoutRecordedBy")
  ticketDesignsUpdated         TicketDesign[] @relation("TicketDesignUpdatedBy")
  refundRequestsDecided        RefundRequest[] @relation("RefundRequestDecidedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A browser this account signed in from with a password. A sign-in from a
/// device it hasn't used before needs an emailed code (unless an
/// authenticator code was given) and sends a "new sign-in" alert.
model UserDevice {
  id         String   @id @default(cuid())
  userId     String
  /// SHA-256 of the random id the browser keeps; the id itself is never stored.
  deviceHash String
  /// A short description of the browser, for the alert and the account page.
  userAgent  String   @default("")
  lastIp     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organisation {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  logoUrl     String?
  createdAt   DateTime @default(now())

  memberships       Membership[]
  invites           OrganisationInvite[]
  events            Event[]
  eventSeries       EventSeries[]
  assets            Asset[]
  auditEvents       AuditEvent[]
  rsvpDeletionUndos RsvpDeletionUndo[]
  apiClients        ApiClient[]
  idProgrammes      IdProgramme[]
  paymentSettings   OrganisationPaymentSettings?
  emailSettings     OrganisationEmailSettings?
  chatChannels      ChatChannel[]
  processedWebhookEvents ProcessedWebhookEvent[]
  orders            Order[]
  prizePayouts      PrizePayout[]
  expenseClaims     ExpenseClaim[]
  claimPayouts      ClaimPayout[]
  refundRequests    RefundRequest[]
  ticketDesigns     TicketDesign[]
  /// The library template tickets use when neither their type nor their event has a design (docs/TICKET_DESIGNER.md).
  defaultTicketDesignId String?      @unique
  defaultTicketDesign   TicketDesign? @relation("OrganisationDefaultTicketDesign", fields: [defaultTicketDesignId], references: [id], onDelete: SetNull)
  payments          Payment[]
  paymentDisputes   PaymentDispute[]
  webhookEndpoints  WebhookEndpoint[]
  savedViews        SavedView[]
}

/// The organisation's own payment provider account. Money goes straight to
/// the organiser; the platform never holds it. Secrets are AES-256-GCM
/// ciphertext (lib/payments/secrets.ts), write-only, and never leave the
/// server. Only the owner may view or change this row.
enum ChatChannelKind {
  SLACK
  DISCORD
  MATTERMOST
  TELEGRAM
  WHATSAPP
}

/// A team chat the organisation's notifications go to (new registrations,
/// requests, payments, refunds...). Its webhook address or bot token is
/// encrypted (lib/orgSecrets.ts) and never shown again.
model ChatChannel {
  id              String          @id @default(cuid())
  organisationId  String
  kind            ChatChannelKind
  name            String
  /// JSON with the webhook address, or the bot or WhatsApp credentials.
  secretEncrypted String
  /// Notification types it receives (lib/chat/events.ts).
  events          String[]
  enabled         Boolean         @default(true)
  lastDeliveredAt DateTime?
  lastFailedAt    DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

/// How an organisation's event email is sent (tickets, reminders, broadcasts,
/// receipts, notices). Account email (sign-up, forgot password) always uses the
/// platform server. The SMTP password is encrypted and never shown again.
model OrganisationEmailSettings {
  organisationId        String    @id
  /// The sender's name; empty uses the organisation's name.
  fromName              String?
  /// Where replies go; empty means replies go to the sending address.
  replyTo               String?
  /// Send through the organisation's own server (tested before it can be on).
  useOwnServer          Boolean   @default(false)
  fromAddress           String?
  smtpHost              String?
  smtpPort              Int?
  /// Port 465: TLS from the start; otherwise STARTTLS is required.
  smtpSecure            Boolean   @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  /// The last successful connection test of the server settings as saved.
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model OrganisationPaymentSettings {
  organisationId                 String           @id
  /// The provider new checkouts use. Never OFFLINE.
  provider                       PaymentProvider?
  /// Uppercase ISO 4217 code for new ticket types.
  currency                       String           @default("INR")
  /// Razorpay's public key id (rzp_test_… or rzp_live_…).
  razorpayKeyId                  String?
  razorpayKeySecretEncrypted     String?
  razorpayWebhookSecretEncrypted String?
  stripeSecretKeyEncrypted       String?
  stripeWebhookSecretEncrypted   String?
  /// Derived from the Stripe key prefix when it is saved (sk_test_/rk_test_).
  stripeTestMode                 Boolean          @default(false)
  /// Random path segment that addresses webhooks without revealing the slug.
  webhookPathId                  String           @unique
  /// Last successful "Test connection" for the selected provider.
  verifiedAt                     DateTime?
  /// Shown on receipts: the registered name, registration number and address.
  receiptLegalName               String?
  receiptRegistrationNumber      String?
  receiptAddress                 String?
  createdAt                      DateTime         @default(now())
  updatedAt                      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

/// Idempotency record for verified provider webhooks. The raw payload is never
/// stored. Rows older than the retention window are purged.
model ProcessedWebhookEvent {
  id             String          @id @default(cuid())
  organisationId String
  provider       PaymentProvider
  eventId        String
  eventType      String
  processedAt    DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, provider, eventId])
  @@index([processedAt])
}

/// A tenant-bound machine identity. It never authenticates through Auth.js.
model ApiClient {
  id             String          @id @default(cuid())
  organisationId String
  name           String
  status         ApiClientStatus @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  scopes       ApiClientScope[]
  credentials  ApiCredential[]
  auditEvents  AuditEvent[]     @relation("AuditActorApiClient")

  @@index([organisationId, status])
}

/// Deliberate application capabilities. Unknown values grant no access.
model ApiClientScope {
  apiClientId String
  scope       String
  createdAt   DateTime @default(now())

  apiClient ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@id([apiClientId, scope])
  @@index([scope])
}

/// A rotatable bearer credential. Only a SHA-256 digest is persisted.
model ApiCredential {
  id          String    @id @default(cuid())
  apiClientId String
  name        String
  secretHash  Bytes
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  apiClient ApiClient @relation(fields: [apiClientId], references: [id], onDelete: Cascade)

  @@index([apiClientId, revokedAt])
  @@index([expiresAt])
}

model OrganisationInvite {
  id              String         @id @default(cuid())
  organisationId  String
  token           String         @unique
  role            MembershipRole @default(MEMBER)
  createdByUserId String
  createdAt       DateTime       @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByUserId    String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("OrgInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  usedBy       User?        @relation("OrgInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, createdAt])
  @@index([usedAt])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organisationId String
  role           MembershipRole
  createdAt      DateTime       @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model Event {
  id                    String           @id @default(cuid())
  organisationId        String
  title                 String
  slug                  String
  description           String           @default("")
  /// Freeform labels used for discovery/search (stored lowercase).
  tags                  String[]         @default([])
  /// Whether public page shows registration counts (confirmed/total).
  showRegistrationCount Boolean          @default(true)
  coverImageUrl         String?
  startDateTime         DateTime
  endDateTime           DateTime
  timezone              String
  location              String           @default("")
  mapLinkUrl            String?
  isOnline              Boolean          @default(false)
  capacity              Int?
  status                EventStatus      @default(DRAFT)
  privacyType           EventPrivacyType @default(PUBLIC)
  /// APPROVAL_REQUIRED only: also list it on the organisation page, Discover and search.
  listedPublicly        Boolean          @default(false)
  registrationClosesAt  DateTime?
  registrationLeadMinutes Int?
  /// bcrypt hash for the public venue check-in station PIN. Incrementing the
  /// version invalidates all existing station proofs.
  checkInStationPinHash String?
  /// Encrypted solely so organisation admins can retrieve the current venue PIN.
  checkInStationPinEncrypted String?
  checkInStationSecretVersion Int @default(0)
  /// Uppercase ISO 4217 code for every ticket and order of this event, set
  /// with the first ticket type and locked after the first sale.
  currency              String?
  /// Paid tickets: what attendees get back when they cancel. After the first
  /// sale it can only become more generous; each order keeps a copy.
  refundPolicyKind      RefundPolicyKind @default(NONE)
  refundPolicyHours     Int?
  refundPolicyPercent   Int?
  refundPolicyText      String           @default("")
  /// Ticket holders may pass their ticket to someone else until this many hours before the start.
  allowTransfers        Boolean          @default(false)
  transferCutoffHours   Int              @default(24)
  /// Optional 7-character share code served at /{shortCode}. Always contains
  /// an uppercase letter so it can never equal a (lowercase) organisation slug.
  shortCode             String?          @unique
  createdAt             DateTime         @default(now())

  organisation     Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rsvps            RSVP[]
  invites          EventInvite[]
  registrationForm EventRegistrationForm?
  feedbackForm     EventFeedbackForm?
  collaborators    EventCollaborator[]
  collaboratorInvites EventCollaboratorInvite[]
  page             EventPage?
  highlights       EventHighlight[]
  scheduleTracks   EventScheduleTrack[]
  sessions         EventSession[]
  speakers         EventSpeaker[]
  sponsors         EventSponsor[]
  venue            EventVenue?
  faqs             EventFaq[]
  resources        EventResource[]
  broadcasts       EventBroadcast[]
  broadcastDrafts  EventBroadcastDraft[]
  badgeDesign      EventBadgeDesign?
  ticketTypes      TicketType[]
  addOns           AddOn[]
  orders           Order[]
  shortLinkClickDays ShortLinkClickDay[]
  promoCodes       PromoCode[]
  checkInLists     CheckInList[]
  savedViews       SavedView[]

  /// TEAM turns on team registration (one-off events only; series stay
  /// individual). Cannot change while the event has registrations.
  registrationMode      RegistrationMode @default(INDIVIDUAL)
  /// Teams below this size are flagged Incomplete and cannot be approved.
  /// CHECK constraints keep 1 <= teamMinSize <= teamMaxSize, teamMaxSize >= 2,
  /// and require teamMaxSize in TEAM mode.
  teamMinSize           Int?
  /// Enforced under the Event row lock; cannot drop below the largest team.
  teamMaxSize           Int?
  soloPolicy            SoloPolicy       @default(SOLO_ALLOWED)
  /// With tickets: who pays. Locked after the first sale.
  teamTicketMode        TeamTicketMode   @default(PER_MEMBER)
  teams            Team[]
  /// Hackathon submissions and judging (docs/HACKATHON.md, one-off events).
  submissionsEnabled                  Boolean          @default(false)
  /// Submission window, checked against server time in the write transaction.
  /// A CHECK constraint keeps submissionsCloseAt after submissionsOpenAt.
  submissionsOpenAt                   DateTime?
  submissionsCloseAt                  DateTime?
  judgingStatus                       JudgingStatus    @default(NOT_STARTED)
  /// true: every judge sees every submitted project; false: only assigned ones.
  judgesSeeAll                        Boolean          @default(true)
  /// After the window closes, list submitted projects at /{org}/{event}/projects.
  projectGalleryPublic                Boolean          @default(false)
  /// Set when results are published (/{org}/{event}/results); null hides them.
  resultsPublishedAt                  DateTime?
  /// First delivery of the results-published announcement; kept across
  /// unpublish/republish so nobody is emailed twice.
  resultsAnnouncedAt                  DateTime?
  /// Target number of judges per project for automatic assignment and the
  /// progress dashboard; null means not set. CHECK keeps it in 1..20.
  reviewsPerProject                   Int?
  /// How result scores are combined across judges.
  scoreNormalization                  ScoreNormalization @default(RAW)
  /// The round judges work on now: the latest round that has opened, else
  /// the first. judgingStatus, judgesSeeAll, reviewsPerProject and
  /// scoreNormalization mirror this round for this release (a trigger copies
  /// Event changes onto it); null means the event's first round, if any.
  currentJudgingRoundId               String?          @unique
  currentJudgingRound                 JudgingRound?    @relation("EventCurrentJudgingRound", fields: [currentJudgingRoundId], references: [id], onDelete: SetNull)
  judgingRounds                       JudgingRound[]   @relation("EventJudgingRounds")
  /// Hackathon emails the organiser opts into (off by default). When false,
  /// publishing results queues no `results-published` email (an organiser can
  /// send it later with sendResultsAnnouncement) and a project becoming
  /// SUBMITTED, including when its entry fee is paid, queues no
  /// `submission-received` receipt. Registration and payment emails are never gated.
  emailEntrantsOnResults              Boolean          @default(false)
  emailSubmissionReceipts             Boolean          @default(false)
  /// Fee to submit a project, in minor units of the event's currency; null
  /// is free. Paid once per entrant through the normal checkout (Order.submissionId).
  submissionFeeMinor                  BigInt?
  /// Refund the entry fee in full when an organiser disqualifies the project.
  submissionFeeRefundOnDisqualify     Boolean          @default(true)
  submissions         Submission[]
  prizePayouts        PrizePayout[]
  /// Event finance (docs/FINANCE.md): an optional spending budget, and whether
  /// registered participants may claim expenses (travel grants), up to a cap each.
  budgetMinor                         BigInt?
  participantClaimsEnabled            Boolean          @default(false)
  participantClaimCapMinor            BigInt?
  expenseClaims       ExpenseClaim[]
  claimPayouts        ClaimPayout[]
  /// The event's own ticket design (an event-owned TicketDesign), or null for the organisation default.
  ticketDesignId      String?          @unique
  ticketDesign        TicketDesign?    @relation("EventTicketDesign", fields: [ticketDesignId], references: [id], onDelete: SetNull)
  ownTicketDesigns    TicketDesign[]   @relation("TicketDesignEvent")
  judgingCriteria     JudgingCriterion[]
  judgeAssignments    JudgeAssignment[]
  awards              EventAward[]
  @@unique([organisationId, slug])
  @@index([organisationId])
  @@index([organisationId, status])
  @@index([organisationId, status, privacyType])
}

/// A ticket an attendee chooses when registering. `priceMinor` 0 is free.
/// The event's capacity stays the overall cap; `capacity` limits this type
/// within it. Types with registrations are archived, never deleted.
model TicketType {
  id           String    @id @default(cuid())
  /// Exactly one of eventId and eventSeriesId (checked in the database).
  eventId      String?
  eventSeriesId String?
  /// PASS only on a series: one seat on every remaining date.
  kind         TicketTypeKind @default(SINGLE)
  visibility   TicketVisibility @default(PUBLIC)
  /// CODE: digest and first letters of the access code (never stored in clear).
  accessCodeDigest String?
  accessCodeHint   String?
  /// FLEXIBLE: priceMinor is the minimum (0 allows free); buyers choose from there.
  pricing      TicketPricing @default(FIXED)
  suggestedMinor BigInt?
  maxPriceMinor  BigInt?
  /// A group ticket seats this many people (each gets their own registration).
  seatsPerTicket Int @default(1)
  /// Booking fee per ticket, paid by the buyer on top of the price.
  feeMinor     BigInt @default(0)
  /// Buyers may reserve and pay at the desk instead of online.
  payAtDesk    Boolean @default(false)
  /// A design for this ticket only (one of its event's own designs); null uses the event's.
  ticketDesignId String?
  ticketDesign   TicketDesign? @relation("TicketTypeDesign", fields: [ticketDesignId], references: [id], onDelete: SetNull)
  name         String
  description  String    @default("")
  /// Tax-inclusive price in integer minor units of the event's currency.
  priceMinor   BigInt    @default(0)
  capacity     Int?
  minPerOrder  Int       @default(1)
  maxPerOrder  Int       @default(10)
  salesStartAt DateTime?
  salesEndAt   DateTime?
  sortOrder    Int       @default(0)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event      Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  series     EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  rsvps      RSVP[]
  orderLines OrderLine[]
  promoCodes PromoCode[]

  @@index([eventId, sortOrder])
  @@index([eventSeriesId, sortOrder])
}

/// One purchase: its lines are priced by us, the provider only charges the
/// total. It creates one registration per attendee and may have several
/// payments. Orders are ledger rows and outlive their event.
model Order {
  id             String      @id @default(cuid())
  organisationId String
  eventId        String?
  /// A series order: a pass (no date) or one date's tickets.
  eventSeriesId   String?
  eventInstanceId String?
  /// Short order number shown on receipts.
  reference      String      @unique
  /// The buyer's bearer link to the order (attendee details, receipts).
  accessToken    String      @unique @default(cuid(2))
  buyerUserId    String?
  buyerEmail     String
  buyerName      String
  status         OrderStatus @default(PENDING)
  currency       String
  subtotalMinor  BigInt      @default(0)
  discountMinor  BigInt      @default(0)
  feeMinor       BigInt      @default(0)
  taxMinor       BigInt      @default(0)
  totalMinor     BigInt      @default(0)
  testMode       Boolean     @default(false)
  /// While PENDING: the seats are held until then.
  holdExpiresAt  DateTime?
  /// The latest a hold may be extended to so a provider page can open.
  holdCapAt      DateTime?
  promoCodeId    String?
  /// The event's refund policy when the order was placed: { kind, hours, percent, text }.
  refundPolicy   Json?
  /// A day-long payment link's reminder was emailed (once).
  paymentReminderSentAt DateTime?
  /// TEAM events: the team this order pays for. A leader's order created it
  /// (the leader's registration is in the team from the start); a member's
  /// order in PER_MEMBER mode joins it once paid (the registration has no
  /// team until then).
  teamId         String?
  /// Set on a leader's order: the name of the team it creates. It tells a
  /// leader's order from a member's even after the team is gone.
  teamName       String?
  /// A PER_MEMBER member's order paying to join `teamId`: kept when the team is
  /// deleted mid-payment, so the payment is refunded rather than placed solo.
  teamJoin       Boolean     @default(false)
  /// A hackathon entry fee: the project it pays for. Such an order has no
  /// registrations; once paid, the project is submitted.
  submissionId   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  series       EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: SetNull)
  instance     EventInstance? @relation(fields: [eventInstanceId], references: [id], onDelete: SetNull)
  buyer        User?        @relation("OrderBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  promoCode    PromoCode?   @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  submission   Submission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  lines        OrderLine[]
  payments     Payment[]
  rsvps        RSVP[]
  refundRequests RefundRequest[]

  @@index([organisationId, createdAt])
  @@index([eventId, status])
  @@index([eventSeriesId, status])
  @@index([eventInstanceId])
  @@index([status, holdExpiresAt])
  @@index([buyerUserId, createdAt])
  @@index([teamId])
  @@index([submissionId])
}

/// One priced line of an order. Amounts are frozen at purchase.
model OrderLine {
  id            String        @id @default(cuid())
  orderId       String
  kind          OrderLineKind @default(TICKET)
  ticketTypeId  String?
  addOnId       String?
  /// The name shown to the buyer when it was sold.
  description   String
  quantity      Int
  unitMinor     BigInt
  discountMinor BigInt        @default(0)
  /// Tax-exclusive value and tax for GST invoices (0 when not registered).
  taxableMinor  BigInt        @default(0)
  taxMinor      BigInt        @default(0)
  cgstMinor     BigInt        @default(0)
  sgstMinor     BigInt        @default(0)
  igstMinor     BigInt        @default(0)
  taxRateBps    Int           @default(0)
  /// What the buyer pays for this line.
  totalMinor    BigInt
  createdAt     DateTime      @default(now())

  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  addOn      AddOn?      @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([ticketTypeId])
}

/// One attempt to collect money for an order. It is a ledger row: once
/// settled its amount, provider and status are immutable (database trigger).
model Payment {
  id                String          @id @default(cuid())
  organisationId    String
  orderId           String
  amountMinor       BigInt
  currency          String
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider
  externalPaymentId String?
  testMode          Boolean         @default(false)
  /// What the buyer paid for, as shown on receipts.
  description       String
  paidAt            DateTime?
  /// PAID_OFFLINE only. Corrections are PaymentAmendment rows, never edits.
  offlineMethod     OfflinePaymentMethod?
  offlineReference  String?
  /// Who marked it paid offline or waived it.
  settledByUserId   String?
  /// How an online payment was made, read from the provider once paid (e.g. "card", "Visa •••• 4242").
  methodType        String?
  methodSummary     String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organisation Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  order        Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts     PaymentCheckoutAttempt[]
  refunds      PaymentRefund[]
  amendments   PaymentAmendment[]
  disputes     PaymentDispute[]
  settledBy    User?                    @relation("PaymentSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@unique([provider, externalPaymentId])
  @@index([organisationId, createdAt])
  @@index([orderId, status])
  @@index([status, createdAt])
}

/// One hosted checkout page (a Razorpay Payment Link or Stripe Checkout
/// Session). Its id is the reference sent to the provider, so every retry is
/// a new attempt with a unique reference.
model PaymentCheckoutAttempt {
  id         String                @id @default(cuid())
  paymentId  String
  provider   PaymentProvider
  /// The provider's link or session id, once created.
  externalId String?
  url        String?
  expiresAt  DateTime
  status     CheckoutAttemptStatus @default(OPEN)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([paymentId, status])
  @@index([status, expiresAt])
}

/// Money returned on a payment. Pending plus succeeded refunds never exceed
/// the payment (database trigger under a row lock on the payment).
model PaymentRefund {
  id               String              @id @default(cuid())
  paymentId        String
  amountMinor      BigInt
  status           PaymentRefundStatus @default(PENDING)
  externalRefundId String?
  /// Recorded by hand (cash, bank transfer) without calling the provider.
  offline          Boolean             @default(false)
  /// Issued by the system, e.g. a payment that arrived after its seats were released.
  automatic        Boolean             @default(false)
  reason           String              @default("")
  createdByUserId  String?
  /// When the provider was last asked; a retry first looks the refund up by our id.
  submittedAt      DateTime?
  settledAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdBy User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([paymentId, externalRefundId])
  @@index([paymentId, status])
  @@index([status, createdAt])
}

/// An append-only correction to an offline payment's method or reference.
/// The newest row for a field is its current value.
model PaymentAmendment {
  id          String   @id @default(cuid())
  paymentId   String
  field       String
  oldValue    String?
  newValue    String?
  reason      String
  actorUserId String?
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  actor   User?   @relation("PaymentAmendmentActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
}

/// A discount code for one event. Only a SHA-256 digest of the normalised
/// code is stored, with a short hint so organisers can tell codes apart.
model PromoCode {
  id              String            @id @default(cuid())
  /// Exactly one of eventId and eventSeriesId (checked in the database).
  eventId         String?
  eventSeriesId   String?
  codeDigest      String
  hint            String
  kind            PromoDiscountKind
  appliesPer      PromoAppliesPer   @default(TICKET)
  /// PERCENT: 1 to 100. 100 makes the tickets free, with no checkout.
  percentOff      Int?
  /// FIXED: minor units of the event's currency, per ticket or per order.
  amountOffMinor  BigInt?
  /// Only this ticket type, when set.
  ticketTypeId    String?
  /// The order needs at least this many eligible tickets.
  minQuantity     Int               @default(1)
  /// At most this many tickets in one order are discounted (TICKET codes).
  perOrderLimit   Int?
  /// Orders that may use it (held or confirmed); a released hold frees its use.
  maxRedemptions  Int?
  validFrom       DateTime?
  validUntil      DateTime?
  archivedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime          @default(now())

  event      Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  series     EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: NoAction)
  createdBy  User?       @relation("PromoCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  orders     Order[]

  @@unique([eventId, codeDigest])
  @@unique([eventSeriesId, codeDigest])
  @@index([eventId, archivedAt])
  @@index([eventSeriesId, archivedAt])
}

/// An organiser email sent to a selected set of existing registrations.
/// The row is the editable template history; delivery happens one outbox
/// message per recipient so retries never resend the whole audience.
model EventBroadcast {
  id              String                    @id @default(cuid())
  eventId         String
  createdByUserId String?
  /// Registration statuses included in the audience (at least one).
  statuses        RsvpStatus[]
  attendance      BroadcastAttendanceFilter @default(ANY)
  subject         String
  /// Sanitised HTML template with {{placeholders}}; rendered per recipient.
  body            String
  /// Visual design id from lib/email/broadcastDesigns.ts; content is the same for every design.
  design          String                    @default("classic")
  recipientCount  Int                       @default(0)
  createdAt       DateTime                  @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
}

/// One organiser's unsent email in an event's Emails tab, autosaved while
/// they write. Private to its author (unique on event and user) and removed
/// when that organiser sends from the dashboard. Holds only what the organiser
/// entered: the body is sanitised exactly as the send path does.
model EventBroadcastDraft {
  id         String                    @id @default(cuid())
  eventId    String
  userId     String
  subject    String                    @default("")
  /// Sanitised HTML template with {{placeholders}}, as it would be sent.
  body       String                    @default("")
  /// Visual design id from lib/email/broadcastDesigns.ts.
  design     String                    @default("classic")
  /// Selected registration statuses; may be empty while the draft is being written.
  statuses   RsvpStatus[]              @default([])
  attendance BroadcastAttendanceFilter @default(ANY)
  /// Starter template the draft began from (lib/broadcastTemplate.ts), if any.
  templateId String?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model EventInvite {
  id        String   @id @default(cuid())
  eventId   String
  email     String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
  /// Guests · Invites newest first.
  @@index([eventId, createdAt, id])
}

model EventSeries {
  id                 String           @id @default(cuid())
  organisationId     String
  title              String
  slug               String
  description        String           @default("")
  recurrenceRule     String
  /// Duration applied to each materialized instance (ms)
  instanceDurationMs Int              @default(3600000)
  timezone           String
  privacyType        EventPrivacyType @default(PUBLIC)
  /// Seats per date, unless a date sets its own.
  capacity           Int?
  status             EventStatus      @default(DRAFT)
  /// As on Event: every ticket and order of the series, locked after the first sale.
  currency           String?
  refundPolicyKind   RefundPolicyKind @default(NONE)
  refundPolicyHours  Int?
  refundPolicyPercent Int?
  refundPolicyText   String           @default("")
  allowTransfers     Boolean          @default(false)
  transferCutoffHours Int             @default(24)
  createdAt          DateTime         @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  ticketTypes  TicketType[]
  addOns       AddOn[]
  promoCodes   PromoCode[]
  orders       Order[]
  instances    EventInstance[]
  invites      SeriesInvite[]
  collaborators EventCollaborator[]
  collaboratorInvites EventCollaboratorInvite[]
  scheduleItems EventScheduleItem[]

  @@unique([organisationId, slug])
  @@index([organisationId])
}

/// A user-scoped grant for exactly one standalone event or recurring series.
model EventCollaborator {
  id            String            @id @default(cuid())
  eventId       String?
  eventSeriesId String?
  userId        String
  permissions   EventPermission[]
  createdAt     DateTime          @default(now())

  event  Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  series EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@unique([eventSeriesId, userId])
  @@index([userId])
  @@index([eventId])
  @@index([eventSeriesId])
}

/// A single-use bearer invite. The raw token is never stored.
model EventCollaboratorInvite {
  id            String            @id @default(cuid())
  eventId       String?
  eventSeriesId String?
  email         String
  tokenHash     String            @unique
  permissions   EventPermission[]
  createdByUserId String
  usedByUserId  String?
  createdAt     DateTime          @default(now())
  expiresAt     DateTime
  usedAt        DateTime?

  event  Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  series EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  usedBy User?        @relation("EventCollaboratorInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, email])
  @@index([eventSeriesId, email])
  @@index([expiresAt])
}

/// Agenda items retain their planned times; delay minutes cascade at display time.
model EventScheduleItem {
  id            String   @id @default(cuid())
  eventSeriesId String
  title         String
  description   String   @default("")
  startDateTime DateTime
  endDateTime   DateTime
  sortOrder     Int      @default(0)
  delayMinutes  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  series EventSeries @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)

  @@index([eventSeriesId, sortOrder])
}

/// The ID card (badge) design for one event, shared by every check-in desk.
/// `settings` is always normalised by `normalizeIdCardPrintSettings` before
/// it is written and again when it is read.
model EventBadgeDesign {
  id          String   @id @default(cuid())
  eventId     String   @unique
  settings    Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
}

model EventPage {
  id          String @id @default(cuid())
  eventId     String @unique
  /// Website visibility follows the owning event's published status.
  isPublished Boolean @default(false)
  tagline     String @default("")
  logoUrl     String?
  accentColor String?
  aboutHtml   String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event    Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sections EventPageSection[]
}

model EventPageSection {
  id        String               @id @default(cuid())
  pageId    String
  type      EventPageSectionType
  isVisible Boolean              @default(true)
  sortOrder Int                  @default(0)

  page EventPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, type])
  @@index([pageId, sortOrder])
}

model EventHighlight {
  id         String            @id @default(cuid())
  eventId    String
  title      String
  description String           @default("")
  icon       String?
  visibility ContentVisibility @default(DRAFT)
  sortOrder  Int               @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([eventId, sortOrder])
}

model EventVenue {
  id              String            @id @default(cuid())
  eventId         String            @unique
  name            String
  address         String             @default("")
  city            String             @default("")
  country         String             @default("")
  latitude        Decimal?           @db.Decimal(9, 6)
  longitude       Decimal?           @db.Decimal(9, 6)
  mapLinkUrl      String?
  directions      String             @default("")
  parkingInfo     String             @default("")
  publicTransport String             @default("")
  accessibilityInfo String           @default("")
  visibility      ContentVisibility  @default(DRAFT)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rooms EventVenueRoom[]
}

model EventVenueRoom {
  id       String @id @default(cuid())
  venueId  String
  name     String
  sortOrder Int @default(0)

  venue EventVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  @@unique([venueId, name])
  @@index([venueId, sortOrder])
}

/// A named programme lane, such as Main Hall, Workshop Room, or Online Stream.
model EventScheduleTrack {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions EventSession[]

  @@unique([eventId, name])
  @@index([eventId, sortOrder])
}

model EventSession {
  id            String            @id @default(cuid())
  eventId       String
  title         String
  slug          String
  descriptionHtml String           @default("")
  startDateTime DateTime
  endDateTime   DateTime
  type          String            @default("Talk")
  trackId       String
  visibility    ContentVisibility @default(DRAFT)
  sortOrder     Int               @default(0)
  /// Live delay applied to this session and later sessions in the same track.
  delayMinutes  Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  track     EventScheduleTrack @relation(fields: [trackId], references: [id], onDelete: Restrict)
  speakers  EventSessionSpeaker[]
  resources EventResource[]
  @@unique([eventId, slug])
  @@index([eventId, startDateTime, sortOrder])
  @@index([trackId, startDateTime, sortOrder])
}

model EventSpeaker {
  id           String            @id @default(cuid())
  eventId      String
  name         String
  slug         String
  photoUrl     String?
  headline     String             @default("")
  organisation String             @default("")
  bioHtml      String             @default("")
  websiteUrl   String?
  linkedinUrl  String?
  xUrl         String?
  visibility   ContentVisibility  @default(DRAFT)
  sortOrder    Int                @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessions EventSessionSpeaker[]
  @@unique([eventId, slug])
  @@index([eventId, sortOrder])
}

model EventSessionSpeaker {
  eventSessionId String
  speakerId      String
  sortOrder      Int @default(0)

  session EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  speaker EventSpeaker @relation(fields: [speakerId], references: [id], onDelete: Cascade)
  @@id([eventSessionId, speakerId])
  @@index([speakerId, sortOrder])
}

model EventSponsor {
  id          String            @id @default(cuid())
  eventId     String
  name        String
  logoUrl     String?
  description String             @default("")
  websiteUrl  String?
  tier        SponsorTier        @default(PARTNER)
  visibility  ContentVisibility  @default(DRAFT)
  sortOrder   Int                @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([eventId, tier, sortOrder])
}

model EventFaq {
  id         String            @id @default(cuid())
  eventId    String
  question   String
  answerHtml String             @default("")
  visibility ContentVisibility  @default(DRAFT)
  sortOrder  Int                @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([eventId, sortOrder])
}

model EventResource {
  id             String            @id @default(cuid())
  eventId        String?
  eventSessionId String?
  title          String
  description    String             @default("")
  externalUrl    String?
  assetKey       String?
  visibility     ContentVisibility  @default(DRAFT)
  sortOrder      Int                @default(0)

  event   Event?        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  session EventSession? @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  @@index([eventId, sortOrder])
  @@index([eventSessionId, sortOrder])
}

model SeriesInvite {
  id            String   @id @default(cuid())
  eventSeriesId String
  email         String
  createdAt     DateTime @default(now())

  series EventSeries @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)

  @@unique([eventSeriesId, email])
  @@index([eventSeriesId])
}

model EventInstance {
  id            String   @id @default(cuid())
  eventSeriesId String
  startDateTime DateTime
  endDateTime   DateTime
  /// This date's seats; null uses the series capacity.
  capacity      Int?
  /// Cancelled dates take no registrations; their paid orders are refunded.
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())

  series EventSeries @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  rsvps  RSVP[]
  orders Order[]

  @@index([eventSeriesId, startDateTime])
}

model RSVP {
  id              String     @id @default(cuid())
  eventId         String?
  eventInstanceId String?
  userId          String?
  guestEmail      String?
  guestName       String?
  /// Stable dedupe key: `user:${userId}` or `guest:${normalizedEmail}`
  attendeeKey     String
  status          RsvpStatus @default(CONFIRMED)
  /// Opaque per-RSVP token for QR / manual check-in (never include PII).
  checkInToken    String     @unique @default(cuid(2))
  checkedInAt     DateTime?
  createdAt       DateTime   @default(now())
  /// Paid events: the order that bought this ticket, and its ticket type.
  orderId         String?
  ticketTypeId    String?
  /// PENDING_PAYMENT only: mirrors the order's hold; the seat counts until then.
  holdExpiresAt   DateTime?
  /// When the registration joined the waitlist, and when it was offered a
  /// place. Set by the rsvp_waitlist_dates trigger, for waitlist conversion.
  waitlistedAt    DateTime?
  /// The beat emailed this guest's reminder (about a day before the start), once.
  reminderSentAt  DateTime?
  promotedAt      DateTime?

  event             Event?                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Orders are only deleted with their organisation; their tickets go with them.
  order             Order?                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// The ticket's event or series matches this registration's (trigger rsvp_ticket_type_target).
  ticketType        TicketType?             @relation(fields: [ticketTypeId], references: [id], onDelete: NoAction)
  eventInstance     EventInstance?          @relation(fields: [eventInstanceId], references: [id], onDelete: Cascade)
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers           RsvpAnswer[]
  feedbackResponses EventFeedbackResponse[]
  checkInEvents     CheckInEvent[]
  checkInListRecords CheckInListRecord[]
  checkInListEvents  CheckInListEvent[]

  /// Team this registration belongs to (TEAM events only). Invariant: the
  /// RSVP status always equals the team status. Null means a solo unit.
  teamId          String?
  team              Team?                   @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeam           Team?                   @relation("TeamLeader")
  seekerProfile     TeamSeekerProfile?
  teamJoinRequests  TeamJoinRequest[]
  submission        Submission?
  submissionLink    SubmissionLink?
  expenseClaims     ExpenseClaim[]
  @@index([eventId])
  /// "Your registrations" and the personal data export look RSVPs up by user.
  @@index([userId, createdAt])
  @@index([eventId, status, checkedInAt, createdAt(sort: Desc), id(sort: Desc)], map: "RSVP_eventId_status_checkedInAt_createdAt_id_idx")
  /// Guests · People newest first, and "Recent check-ins" (docs/PERFORMANCE.md).
  @@index([eventId, createdAt, id])
  @@index([eventId, checkedInAt, id])
  @@index([eventInstanceId])
  @@index([eventId, attendeeKey])
  @@index([eventInstanceId, attendeeKey])
  @@index([checkInToken])
  @@index([orderId])
  @@index([ticketTypeId, status])
  @@index([status, holdExpiresAt])
  @@index([teamId])
}

/// Short-lived, server-created snapshots used to undo an organiser deletion.
/// Never accept RSVP snapshots directly from a browser.
model RsvpDeletionUndo {
  id              String   @id @default(cuid())
  organisationId  String
  deletedByUserId String
  payload         Json
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  deletedBy    User         @relation(fields: [deletedByUserId], references: [id], onDelete: Cascade)

  @@index([organisationId, expiresAt])
  @@index([expiresAt])
}

model EventRegistrationForm {
  id        String   @id @default(cuid())
  eventId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event  Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields EventRegistrationField[]

  @@index([eventId])
}

model EventRegistrationField {
  id        String                @id @default(cuid())
  formId    String
  key       String
  label     String
  type      RegistrationFieldType
  required  Boolean               @default(false)
  sortOrder Int                   @default(0)
  /// For SELECT / MULTI_SELECT / RADIO (array of strings)
  options   Json?
  /// Short guidance shown under the question.
  helpText    String @default("")
  /// Example shown inside empty text inputs.
  placeholder String @default("")
  /// Validation and logic, shape in lib/registrationFields.ts (FieldSettings):
  /// length/range/date limits, max selections, "Other" option, show-only-if.
  settings    Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  form    EventRegistrationForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers RsvpAnswer[]

  @@unique([formId, key])
  @@index([formId, sortOrder])
  @@index([formId, type])
}

model RsvpAnswer {
  id          String    @id @default(cuid())
  rsvpId      String
  fieldId     String
  valueText   String?
  valueBool   Boolean?
  valueNumber Float?
  valueDate   DateTime?
  createdAt   DateTime  @default(now())

  rsvp  RSVP                   @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  field EventRegistrationField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@index([rsvpId])
  @@index([fieldId])
  @@index([rsvpId, fieldId])
}

/// A public, opt-in feedback form. It is deliberately separate from the
/// registration form so changing questions never alters RSVP data.
model EventFeedbackForm {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  isOpen             Boolean  @default(false)
  title              String   @default("Event feedback")
  thankYouMessage    String   @default("Thanks for sharing your feedback.")
  certificateEnabled Boolean  @default(false)
  certificateTemplate Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  event     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fields    EventFeedbackField[]
  responses EventFeedbackResponse[]
}

model EventFeedbackField {
  id        String                @id @default(cuid())
  formId    String
  key       String
  label     String
  type      RegistrationFieldType
  required  Boolean               @default(false)
  sortOrder Int                   @default(0)
  options   Json?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  form    EventFeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  answers EventFeedbackAnswer[]

  @@unique([formId, key])
  @@index([formId, sortOrder])
}

model EventFeedbackResponse {
  id               String   @id @default(cuid())
  formId           String
  rsvpId           String?
  certificateToken String?  @unique @default(cuid(2))
  certificateTemplate Json?
  submittedAt      DateTime @default(now())

  form    EventFeedbackForm     @relation(fields: [formId], references: [id], onDelete: Cascade)
  rsvp    RSVP?                 @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  answers EventFeedbackAnswer[]

  @@index([rsvpId])
}

model EventFeedbackAnswer {
  id          String    @id @default(cuid())
  responseId  String
  fieldId     String?
  /// Immutable field semantics retained even when organisers later edit or
  /// remove the live form field.
  fieldKey    String
  fieldLabel  String
  fieldType   RegistrationFieldType
  valueText   String?
  valueBool   Boolean?
  valueNumber Float?
  valueDate   DateTime?
  createdAt   DateTime  @default(now())

  response EventFeedbackResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  field    EventFeedbackField?   @relation(fields: [fieldId], references: [id], onDelete: SetNull)

  @@index([responseId])
  @@index([fieldId])
}

/// Append-only security and business-event audit trail. Metadata must never
/// contain secrets, passwords, reset links, or ticket tokens.
model AuditEvent {
  id               String   @id @default(cuid())
  action           String
  actorUserId      String?
  actorApiClientId String?
  organisationId   String?
  targetType       String?
  targetId         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorApiClient ApiClient?    @relation("AuditActorApiClient", fields: [actorApiClientId], references: [id], onDelete: SetNull)
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorApiClientId, createdAt])
  @@index([action, createdAt])
}

/// Immutable record of every check-in and undo operation, including offline
/// synchronisation. `RSVP.checkedInAt` remains the current projection.
model CheckInEvent {
  id          String   @id @default(cuid())
  rsvpId      String?
  actorUserId String?
  action      String
  source      String
  occurredAt  DateTime @default(now())

  rsvp  RSVP? @relation(fields: [rsvpId], references: [id], onDelete: SetNull)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([rsvpId, occurredAt])
  @@index([actorUserId, occurredAt])
}

/// An organiser-defined check-in list beyond venue entry ("Swag collection",
/// "Lunch – Day 1", "Workshop B"). Standalone events only. Names are unique per
/// event among non-archived lists, case-insensitively, through the partial
/// index `CheckInList_eventId_active_name_key` (declared in the migration,
/// because Prisma cannot model it). Archived lists are read-only.
model CheckInList {
  id                   String   @id @default(cuid())
  eventId              String
  name                 String
  sortOrder            Int      @default(0)
  archived             Boolean  @default(false)
  /// Guests must already be checked in at entry before they can be marked here.
  requiresEntryCheckIn Boolean  @default(false)
  /// Only guests whose confirmed order bought this add-on, up to the quantity
  /// bought per order (meals, swag, workshops).
  addOnId              String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  event   Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  addOn   AddOn?              @relation(fields: [addOnId], references: [id], onDelete: NoAction)
  records CheckInListRecord[]
  history CheckInListEvent[]

  @@index([eventId, archived, sortOrder])
  @@index([addOnId])
}

/// One person checked into one custom list. Unique on (listId, rsvpId), so a
/// guest is in a list at most once; undo deletes the row. Independent of
/// entry check-in (`RSVP.checkedInAt`), which list check-ins never change.
model CheckInListRecord {
  id          String   @id @default(cuid())
  listId      String
  rsvpId      String
  actorUserId String?
  /// `online`, `mobile-scan` or `mobile-manual` (`CheckInListRecord_known_source`).
  source      String
  checkedInAt DateTime @default(now())

  list  CheckInList @relation(fields: [listId], references: [id], onDelete: Cascade)
  rsvp  RSVP        @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  actor User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([listId, rsvpId])
  @@index([rsvpId])
  @@index([actorUserId])
}

/// Immutable history of list check-ins and undos, kept apart from
/// `CheckInEvent` so entry reports and check-in source counts never include
/// list activity. Like `CheckInEvent`, a deleted RSVP or actor leaves the row
/// with a null reference; deleting the event (and so the list) removes it.
model CheckInListEvent {
  id          String   @id @default(cuid())
  listId      String
  rsvpId      String?
  actorUserId String?
  /// `CHECKED_IN` or `CHECK_IN_UNDONE` (`CheckInListEvent_known_action`).
  action      String
  source      String
  occurredAt  DateTime @default(now())

  list  CheckInList @relation(fields: [listId], references: [id], onDelete: Cascade)
  rsvp  RSVP?       @relation(fields: [rsvpId], references: [id], onDelete: SetNull)
  actor User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([listId, occurredAt])
  @@index([rsvpId, occurredAt])
  @@index([actorUserId, occurredAt])
}

/// Durable queue for transactional messages. A background worker claims and
/// retries these rows; request handlers only enqueue them.
model OutboxMessage {
  id          String       @id @default(cuid())
  kind        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
  @@index([createdAt])
}

/// One-row operational state for externally scheduled work. This is separate
/// from the append-only human audit trail so frequent scheduler runs do not
/// drown out meaningful application activity.
model OperationalHeartbeat {
  key             String    @id
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastSent        Int       @default(0)
  lastFailed      Int       @default(0)
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

/// Instance-wide, super-admin-managed controls. The singleton row is created
/// on first change; absence deliberately preserves the secure default below.
model InstanceSetting {
  id                    String   @id
  allowNewUserSignups   Boolean  @default(true)
  emailFrom             String?
  smtpService           String?
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean  @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  smtpAllowUnauthenticated Boolean @default(false)
  googleClientId        String?
  googleClientSecretEncrypted String?
  backupProvider        String?
  backupLastSuccessAt   DateTime?
  backupRetentionDays   Int?
  /// Organisations may sell tickets only while this is on.
  paidEventsEnabled     Boolean  @default(false)
  /// Incoming-webhook URL (e.g. Mattermost) for operational alerts. The URL
  /// embeds its own credential, so it is encrypted and write-only.
  opsWebhookUrlEncrypted String?
  opsWebhookEnabled      Boolean  @default(false)
  opsWebhookIncludeWarnings Boolean @default(true)
  updatedAt             DateTime @updatedAt
}

/// Tracks stored files (S3/R2/MinIO/etc.) for per-org storage accounting.
/// This is optional for runtime today but enables accurate “bytes stored” metrics.
model Asset {
  id             String   @id @default(cuid())
  organisationId String?
  /// Provider-specific object key (or path).
  key            String   @unique
  /// Public URL if you store it (optional).
  publicUrl      String?
  contentType    String?
  byteSize       BigInt?
  provider       String   @default("unknown")
  fileData       Bytes?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([createdAt])
  @@index([provider])
}

/// Member IDs: an organisation's ID card programme (Aarannu-style digital IDs).
enum IdProgrammeStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum IdMemberStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum IdFieldType {
  TEXT
  SELECT
  DATE
  EMAIL
  PHONE
}

enum IdFieldPlacement {
  FRONT
  BACK
  HIDDEN
}

enum IdMemberSource {
  FORM
  IMPORT
  MANUAL
}

/// A set of ID cards an organisation issues: who can join, how long cards last, and the front/back design.
model IdProgramme {
  id               String            @id @default(cuid())
  organisationId   String
  name             String
  slug             String
  description      String            @default("")
  status           IdProgrammeStatus @default(DRAFT)
  /// Public join form accepts new requests (only while ACTIVE).
  registrationOpen Boolean           @default(false)
  requiresApproval Boolean           @default(true)
  /// Printed ID numbers are `<idPrefix>-<year>-<sequence>`.
  idPrefix         String
  nextSequence     Int               @default(1)
  /// A fixed expiry date for every card, or a number of days from issue; neither means no expiry.
  validUntil       DateTime?
  validityDays     Int?
  /// Front and back card design (normalised by lib/memberIds/design.ts).
  design           Json?
  /// Managed upload used as an image watermark.
  watermarkUrl     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fields       IdProgrammeField[]
  members      IdMember[]

  @@unique([organisationId, slug])
  /// Target of IdMember's composite key, so a member can never sit in another organisation's programme.
  @@unique([id, organisationId])
  @@index([organisationId, createdAt])
}

/// A custom question on the join form, optionally printed on the card front or back.
model IdProgrammeField {
  id          String           @id @default(cuid())
  programmeId String
  key         String
  label       String
  type        IdFieldType      @default(TEXT)
  required    Boolean          @default(false)
  options     String[]         @default([])
  placement   IdFieldPlacement @default(FRONT)
  sortOrder   Int              @default(0)

  programme IdProgramme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  @@unique([programmeId, key])
  @@index([programmeId, sortOrder])
}

/// One person's ID card in a programme. `verifyToken` is an opaque bearer value printed in the QR.
model IdMember {
  id             String         @id @default(cuid())
  programmeId    String
  organisationId String
  userId         String?
  name           String
  /// Lower-cased; one card per email per programme.
  email          String
  photoUrl       String?
  fieldValues    Json           @default("{}")
  status         IdMemberStatus @default(PENDING)
  source         IdMemberSource @default(FORM)
  idNumber       String?
  verifyToken    String         @unique
  issuedAt       DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  /// Organiser's note for a rejection or revocation. Never shown on the verify page.
  statusReason   String?
  /// When the "your ID card" email was last queued; drives the resend cooldown and the daily cap.
  lastEmailedAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  programme IdProgramme @relation(fields: [programmeId, organisationId], references: [id, organisationId], onDelete: Cascade)
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([programmeId, email])
  @@unique([programmeId, idNumber])
  @@index([programmeId, status, createdAt])
  @@index([organisationId, lastEmailedAt])
  @@index([userId])
  @@index([email])
}

/// Short-link visits per event per day, in the event's timezone. Counts only:
/// no IP address, browser, referrer or person is stored.
model ShortLinkClickDay {
  eventId String
  day     DateTime @db.Date
  count   Int      @default(0)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, day])
}

/// Something bought alongside tickets (a T-shirt, lunch, a donation). It
/// takes no seat. Exactly one of eventId and eventSeriesId (checked).
model AddOn {
  id            String    @id @default(cuid())
  eventId       String?
  eventSeriesId String?
  name          String
  description   String    @default("")
  priceMinor    BigInt
  /// How many can be sold in all; null is unlimited.
  capacity      Int?
  maxPerOrder   Int       @default(10)
  sortOrder     Int       @default(0)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  event      Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  series     EventSeries? @relation(fields: [eventSeriesId], references: [id], onDelete: Cascade)
  orderLines OrderLine[]
  checkInLists CheckInList[]

  @@index([eventId, sortOrder])
  @@index([eventSeriesId, sortOrder])
}

/// A dispute (chargeback) on a captured payment, from the provider's
/// webhooks. Nothing is cancelled automatically; the owner is emailed.
model PaymentDispute {
  id                String          @id @default(cuid())
  organisationId    String
  paymentId         String
  provider          PaymentProvider
  externalDisputeId String
  status            DisputeStatus
  amountMinor       BigInt
  currency          String
  reason            String          @default("")
  /// The provider's deadline for evidence.
  respondBy         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalDisputeId])
  @@index([paymentId])
  @@index([organisationId, status])
}

/// An organisation's outgoing webhook receiver (docs/WEBHOOKS.md). The signing
/// secret is stored only as AES-GCM ciphertext under a domain-separated key and
/// is shown to the organiser once, on create or rotate.
model WebhookEndpoint {
  id                  String    @id @default(cuid())
  organisationId      String
  url                 String
  description         String    @default("")
  /// Subscribed event types (lib/webhooks/eventTypes.ts). `ping` is always deliverable as a test.
  eventTypes          String[]
  enabled             Boolean   @default(true)
  secretEncrypted     String
  /// Why the endpoint is off when it was not switched off by a person ("auto_disabled").
  disabledReason      String?
  disabledAt          DateTime?
  consecutiveFailures Int       @default(0)
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  createdByUserId     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?             @relation("WebhookEndpointCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  deliveries   WebhookDelivery[]

  @@index([organisationId, enabled])
}

/// Durable delivery queue: one row per endpoint and event. A worker claims rows
/// with FOR UPDATE SKIP LOCKED; request paths only insert them after commit.
model WebhookDelivery {
  id             String                @id @default(cuid())
  endpointId     String
  organisationId String
  /// Stable envelope id (`evt_…`), identical on every retry for receiver idempotency.
  eventId        String
  eventType      String
  /// The complete minimal envelope as sent. Never holds tokens, answers, or secrets.
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now())
  lockedAt       DateTime?
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  lastStatusCode Int?
  /// Short, redacted failure summary (never the full response body).
  lastError      String?
  responseTimeMs Int?
  createdAt      DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([organisationId, createdAt])
  @@index([createdAt])
}

/// A named filter/search state on one event-dashboard list. `params` is
/// validated against the surface's allow-list on write and again on read
/// (unknown keys dropped); it never grants access: the surface's own
/// permission is checked first. Shared views are visible to everyone who can
/// open that surface on the event.
model SavedView {
  id             String           @id @default(cuid())
  organisationId String
  eventId        String
  /// The creator; only they can rename, re-share or (with owners/admins for shared views) delete it.
  userId         String
  surface        SavedViewSurface
  /// Up to 60 characters.
  name           String
  params         Json
  shared         Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, surface])
  @@index([userId])
  @@index([organisationId])
}

/// A registration unit on a TEAM event. Capacity counts each team once,
/// however many members it has. Every mutation locks the Event row first
/// (lib/core/teams.ts) so team changes serialise with all capacity changes.
model Team {
  id                String     @id @default(cuid())
  eventId           String
  name              String
  /// Lowercased, trimmed, whitespace-collapsed name; unique per event.
  nameKey           String
  /// Mirrors every member RSVP's status (updated together, guarded by the
  /// expected previous status).
  status            RsvpStatus
  /// Opaque bearer value for the shareable join link. Regenerating retires
  /// the old link. Reveals only team name and size.
  joinToken         String     @unique
  /// SHA-256 (hex) of the leader's team management token. The raw token is
  /// shown once (in the team-created email) and never stored.
  manageTokenHash   String     @unique
  leaderRsvpId      String?    @unique
  lookingForMembers Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  leaderRsvp   RSVP?             @relation("TeamLeader", fields: [leaderRsvpId], references: [id], onDelete: SetNull)
  members      RSVP[]            @relation("TeamMembers")
  joinRequests TeamJoinRequest[]
  orders       Order[]

  submission   Submission?
  @@unique([eventId, nameKey])
  @@index([eventId, status, createdAt])
  /// Guests · Teams oldest first (keyset on createdAt, id).
  @@index([eventId, createdAt, id])
}

/// Opt-in "Looking for a team" listing for a solo registrant of a
/// SOLO_WITH_MATCHING event. Shown only to the same event's team leaders and
/// visible seekers, as display name + headline + skills.
model TeamSeekerProfile {
  id        String   @id @default(cuid())
  rsvpId    String   @unique
  headline  String
  /// Up to 8 skills, each up to 30 characters.
  skills    String[] @default([])
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsvp RSVP @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
}

/// Leader invitation to a seeker (INVITE) or seeker request to a team
/// (REQUEST). A partial unique index allows at most one PENDING row per
/// team and RSVP. No email is sent for these in this version.
model TeamJoinRequest {
  id        String                   @id @default(cuid())
  teamId    String
  rsvpId    String
  direction TeamJoinRequestDirection
  status    TeamJoinRequestStatus    @default(PENDING)
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rsvp RSVP @relation(fields: [rsvpId], references: [id], onDelete: Cascade)

  @@index([teamId, status])
  @@index([rsvpId, status])
}

/// A hackathon project (docs/HACKATHON.md). The entrant is exactly one of a
/// team or a solo RSVP (CHECK constraint), each with at most one submission,
/// and the submission is deleted with its team, RSVP, or event. Always read
/// together with `eventId`; the entrant must belong to the same event.
model Submission {
  id                 String           @id @default(cuid())
  eventId            String
  teamId             String?          @unique
  rsvpId             String?          @unique
  /// Up to 120 characters.
  title              String
  /// Plain text, up to 4000 characters.
  summary            String           @default("")
  /// Optional https: links, up to 500 characters each.
  repoUrl            String?
  demoUrl            String?
  videoUrl           String?
  status             SubmissionStatus @default(DRAFT)
  /// Set on (re)submission; kept when an organiser disqualifies.
  submittedAt        DateTime?
  /// Organiser-only note; never shown to entrants, judges, or the public.
  disqualifiedReason String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team        Team?              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rsvp        RSVP?              @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
  assignments JudgeAssignment[]
  scores      JudgeScore[]
  reviews     JudgeReview[]
  awardWins   EventAwardWinner[]
  roundEntries JudgingRoundEntry[]
  entryFeeOrders Order[]
  prizePayouts PrizePayout[]

  @@index([eventId, status])
  /// Judging → Submissions (keyset on createdAt, id).
  @@index([eventId, createdAt, id])
  /// SUBMITTED projects by submission time: judge workspace, gallery, ranking.
  @@index([eventId, status, submittedAt, id])
}

/// Bearer link `/submit/{token}` for a solo registrant's submission, emailed
/// to the RSVP's own address. Only the SHA-256 digest is stored; regenerating
/// replaces the row and retires the old link.
model SubmissionLink {
  id        String   @id @default(cuid())
  rsvpId    String   @unique
  /// Hex SHA-256 of the raw token (64 characters).
  tokenHash String   @unique
  createdAt DateTime @default(now())

  rsvp RSVP @relation(fields: [rsvpId], references: [id], onDelete: Cascade)
}

/// One rubric line. Frozen once judging leaves NOT_STARTED. CHECK
/// constraints keep weight and maxScore within 1..10.
model JudgingCriterion {
  id          String   @id @default(cuid())
  eventId     String
  /// The round this line belongs to. Always set (CHECK constraint); a
  /// trigger fills it with the event's current round when an insert omits it.
  roundId     String?
  /// Up to 80 characters.
  name        String
  /// Up to 500 characters.
  description String   @default("")
  weight      Int      @default(1)
  maxScore    Int      @default(10)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  event  Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round  JudgingRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  scores JudgeScore[]

  @@index([eventId, position])
  @@index([roundId, position])
}

/// Used when `Event.judgesSeeAll` is false: the judge sees only assigned
/// submissions. Conflict of interest is checked separately, at read and write.
model JudgeAssignment {
  id           String   @id @default(cuid())
  eventId      String
  /// Always set (CHECK constraint); filled with the current round when omitted.
  roundId      String?
  judgeUserId  String
  submissionId String
  createdAt    DateTime @default(now())

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  round      JudgingRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  judge      User       @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([roundId, judgeUserId, submissionId])
  @@index([eventId, judgeUserId])
  @@index([submissionId])
}

/// One integer score per submission, judge, and criterion (0..maxScore,
/// checked by the core; the CHECK constraint keeps it non-negative).
model JudgeScore {
  id           String   @id @default(cuid())
  submissionId String
  judgeUserId  String
  criterionId  String
  score        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submission Submission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge      User             @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)
  criterion  JudgingCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, judgeUserId, criterionId])
  @@index([judgeUserId])
  @@index([criterionId])
}

/// A judge's review of one submission. Only reviews with `submittedAt`
/// count towards the result score. The comment is visible to organisers only.
model JudgeReview {
  id           String    @id @default(cuid())
  /// Always set (CHECK constraint); filled with the current round when omitted.
  roundId      String?
  submissionId String
  judgeUserId  String
  /// Up to 2000 characters, organisers only.
  comment      String    @default("")
  submittedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  round      JudgingRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  judge      User       @relation(fields: [judgeUserId], references: [id], onDelete: Cascade)

  @@unique([roundId, submissionId, judgeUserId])
  @@index([judgeUserId])
  @@index([submissionId])
}

/// One judging round of a hackathon (docs/HACKATHON.md "Rounds"). Rounds run
/// in `position` order (unique per event); at most one is OPEN (partial
/// unique index). Criteria, assignments and reviews belong to a round, and
/// scores follow their criterion. A round with `entrySource = ADVANCED`
/// judges only its JudgingRoundEntry rows; results and awards come from the
/// event's final round. CHECK constraints keep the name non-empty,
/// reviewsPerProject in 1..20 and closesAt after opensAt.
model JudgingRound {
  id                   String                  @id @default(cuid())
  eventId              String
  /// Up to 80 characters.
  name                 String
  position             Int
  status               JudgingRoundStatus      @default(DRAFT)
  reviewsPerProject    Int?
  scoreNormalization   ScoreNormalization      @default(RAW)
  judgesSeeAll         Boolean                 @default(true)
  /// "Fresh eyes": a judge never gets a project they reviewed in an earlier round.
  freshEyes            Boolean                 @default(false)
  entrySource          JudgingRoundEntrySource @default(ALL_SUBMITTED)
  /// Planned times, shown to organisers and judges; opening and closing stay manual.
  opensAt              DateTime?
  closesAt             DateTime?
  /// Set when the organiser publishes this round's finalists (separate from results).
  finalistsPublishedAt DateTime?
  /// Set when the organiser finalises a CLOSED round (it can no longer reopen);
  /// finalists advance only from a finalised round. Finalising a round whose
  /// projects are short of the review target needs `finalizeExceptionReason`
  /// (organiser-only, up to 500 characters; CHECK keeps it with finalizedAt).
  finalizedAt          DateTime?
  finalizeExceptionReason String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  event       Event               @relation("EventJudgingRounds", fields: [eventId], references: [id], onDelete: Cascade)
  currentFor  Event?              @relation("EventCurrentJudgingRound")
  criteria    JudgingCriterion[]
  assignments JudgeAssignment[]
  reviews     JudgeReview[]
  entries     JudgingRoundEntry[]
  panel       JudgingRoundJudge[]
  assignmentRuns JudgingAssignmentRun[]
  finalistNotices JudgingFinalistNotice[]

  @@unique([eventId, position])
  @@index([eventId, status])
}

/// A project advanced into an ADVANCED round. Written only while the round is
/// DRAFT (frozen once it opens); the submission must belong to the round's
/// event (trigger). `sourceRank` is its rank in the previous round, if any.
model JudgingRoundEntry {
  id               String   @id @default(cuid())
  roundId          String
  submissionId     String
  advancedByUserId String?
  advancedAt       DateTime @default(now())
  sourceRank       Int?

  round      JudgingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  submission Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  advancedBy User?        @relation("JudgingRoundEntryAdvancedBy", fields: [advancedByUserId], references: [id], onDelete: SetNull)

  @@unique([roundId, submissionId])
  @@index([submissionId])
}

/// An optional per-round judging panel. A round with no rows is judged by
/// everyone who can judge the event; with rows, only these people (who must
/// still hold a JUDGE grant or be an organisation owner/admin) judge it.
model JudgingRoundJudge {
  id        String   @id @default(cuid())
  roundId   String
  userId    String
  createdAt DateTime @default(now())

  round JudgingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([userId])
}

/// An award category (e.g. "Overall winner"). Winners are assigned manually.
model EventAward {
  id          String   @id @default(cuid())
  eventId     String
  /// Up to 80 characters.
  name        String
  /// Up to 500 characters.
  description String   @default("")
  position    Int      @default(0)
  /// Prize money per winner, in minor units of the event's currency; null is none.
  prizeMinor  BigInt?
  createdAt   DateTime @default(now())

  event   Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  winners EventAwardWinner[]
  payouts PrizePayout[]

  @@index([eventId, position])
}

/// A winning submission for an award, by place (1 or more). One submission per
/// place and at most one place per submission in each award.
model EventAwardWinner {
  id           String   @id @default(cuid())
  awardId      String
  submissionId String
  place        Int      @default(1)
  createdAt    DateTime @default(now())

  award      EventAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([awardId, place])
  @@unique([awardId, submissionId])
  @@index([submissionId])
}

/// Prize money paid to an award winner, recorded by an owner or admin
/// (docs/HACKATHON.md). Append-only (database trigger): only the references
/// may be cleared when what they point at is deleted. A mistake is undone by a
/// reversal row (`reversesId`), at most one per payout. Names are copied so
/// the record survives the award or project being deleted.
model PrizePayout {
  id               String               @id @default(cuid())
  organisationId   String
  eventId          String?
  awardId          String?
  submissionId     String?
  awardName        String
  projectTitle     String
  recipientName    String
  amountMinor      BigInt
  currency         String
  method           OfflinePaymentMethod
  reference        String?
  note             String               @default("")
  paidAt           DateTime
  reversesId       String?              @unique
  recordedByUserId String?
  createdAt        DateTime             @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  award        EventAward?  @relation(fields: [awardId], references: [id], onDelete: SetNull)
  submission   Submission?  @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  reverses     PrizePayout? @relation("PrizePayoutReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy   PrizePayout? @relation("PrizePayoutReversal")
  recordedBy   User?        @relation("PrizePayoutRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([organisationId, createdAt])
  @@index([awardId])
  @@index([submissionId])
}

/// Who an expense claim is from (docs/FINANCE.md).
enum ExpenseClaimKind {
  /// Organisation members and event co-organisers, for themselves or on behalf of a speaker or volunteer.
  STAFF
  /// A registered participant, from their ticket page (travel grants).
  PARTICIPANT
}

enum ExpenseClaimStatus {
  SUBMITTED
  APPROVED
  REJECTED
  /// Paid out: a ClaimPayout row records how.
  PAID
  /// Taken back by its claimant before a decision.
  WITHDRAWN
}

enum ExpenseCategory {
  TRAVEL
  ACCOMMODATION
  FOOD
  VENUE
  EQUIPMENT
  PRINTING
  MARKETING
  SUPPLIES
  OTHER
}

/// A request to be paid back for money spent on an event. Owners and admins
/// approve (up to the amount asked), reject, and pay; every step is audited.
/// Names and the event title are copied so the record outlives the event.
model ExpenseClaim {
  id                String             @id @default(cuid())
  organisationId    String
  eventId           String?
  eventTitle        String
  kind              ExpenseClaimKind
  status            ExpenseClaimStatus @default(SUBMITTED)
  submittedByUserId String?
  /// PARTICIPANT claims: the registration that made it.
  rsvpId            String?
  payeeName         String
  payeeEmail        String
  category          ExpenseCategory
  description       String
  amountMinor       BigInt
  approvedMinor     BigInt?
  currency          String
  /// Why it was rejected, or a note with the approval; shown to the claimant.
  decisionNote      String             @default("")
  decidedByUserId   String?
  decidedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  submittedBy  User?            @relation("ExpenseClaimSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  decidedBy    User?            @relation("ExpenseClaimDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  rsvp         RSVP?            @relation(fields: [rsvpId], references: [id], onDelete: SetNull)
  receipts     ExpenseReceipt[]
  payouts      ClaimPayout[]

  @@index([eventId, status, createdAt])
  @@index([organisationId, createdAt])
  @@index([submittedByUserId])
  @@index([rsvpId])
}

/// A photo of a receipt, re-encoded as WebP and kept in private storage
/// (Asset key `organisations/{id}/claim-receipts/{uuid}.webp`), served only to
/// the organisation's owners and admins and the claimant.
model ExpenseReceipt {
  id         String   @id @default(cuid())
  claimId    String
  storageKey String   @unique
  byteSize   Int
  createdAt  DateTime @default(now())

  claim ExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

/// Money paid back on an approved claim. Append-only like PrizePayout: only
/// references may be cleared, and a mistake is undone with a reversal row.
model ClaimPayout {
  id               String               @id @default(cuid())
  organisationId   String
  eventId          String?
  claimId          String?
  payeeName        String
  amountMinor      BigInt
  currency         String
  method           OfflinePaymentMethod
  reference        String?
  note             String               @default("")
  paidAt           DateTime
  reversesId       String?              @unique
  recordedByUserId String?
  createdAt        DateTime             @default(now())

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  claim        ExpenseClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)
  reverses     ClaimPayout?  @relation("ClaimPayoutReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy   ClaimPayout?  @relation("ClaimPayoutReversal")
  recordedBy   User?         @relation("ClaimPayoutRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt])
  @@index([organisationId, createdAt])
  @@index([claimId])
}

enum RefundRequestStatus {
  OPEN
  APPROVED
  DECLINED
  WITHDRAWN
}

/// A buyer asking for money back outside the automatic refund policy. An
/// owner or admin approves (running the normal refund, in full or in part,
/// optionally cancelling the tickets) or declines with a reason. At most one
/// open request per order (partial unique index).
model RefundRequest {
  id              String              @id @default(cuid())
  organisationId  String
  orderId         String
  status          RefundRequestStatus @default(OPEN)
  reason          String
  approvedMinor   BigInt?
  cancelTickets   Boolean             @default(false)
  decisionNote    String              @default("")
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  decidedBy    User?        @relation("RefundRequestDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@index([orderId, status])
  @@index([organisationId, status, createdAt])
}

/// A ticket design (docs/TICKET_DESIGNER.md): a canvas of text, images,
/// shapes, merge fields and exactly one check-in QR code, validated by
/// lib/ticketDesign/schema.ts on every write. Without an event it is a
/// template in the organisation's library (owners and admins edit it); with
/// one it belongs to that event (EDIT_DETAILS edits it) and can be the event's
/// design or a ticket type's.
model TicketDesign {
  id             String   @id @default(cuid())
  organisationId String
  eventId        String?
  name           String
  document       Json
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  event        Event?        @relation("TicketDesignEvent", fields: [eventId], references: [id], onDelete: Cascade)
  updatedBy    User?         @relation("TicketDesignUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  usedByEvent  Event?        @relation("EventTicketDesign")
  usedByTypes  TicketType[]  @relation("TicketTypeDesign")
  defaultFor   Organisation? @relation("OrganisationDefaultTicketDesign")

  @@index([organisationId, eventId, updatedAt])
  @@index([eventId])
}

/// One applied automatic assignment of a round (docs/HACKATHON.md "Rounds"):
/// the strategy, the RANDOM seed, the target, and fingerprints of the inputs
/// and of the plan, so a run can be explained and reproduced. CHECK
/// constraints keep `mode` to keep/replace, a seed exactly for RANDOM runs
/// (32 hex characters) and the counts non-negative.
model JudgingAssignmentRun {
  id               String                  @id @default(cuid())
  roundId          String
  strategy         JudgeAssignmentStrategy
  /// "keep" or "replace".
  mode             String
  seed             String?
  perProject       Int
  judges           Int
  added            Int
  removed          Int
  adopted          Int
  inputFingerprint String
  planFingerprint  String
  createdByUserId  String?
  createdAt        DateTime                @default(now())

  round     JudgingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("JudgingAssignmentRunBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([roundId, createdAt])
}

/// Who has been told about a round's finalists (docs/HACKATHON.md "Rounds"):
/// one row per round and recipient, kept after the outbox row is delivered and
/// cleaned up, so republishing never emails anyone twice. Only a SHA-256 of
/// the lowercased address is stored (64 hex characters, CHECK).
/// `outboxMessageId` names the queued email, so an unpublish that withdraws it
/// undelivered can forget the recipient again.
model JudgingFinalistNotice {
  id              String   @id @default(cuid())
  roundId         String
  emailHash       String
  outboxMessageId String?
  createdAt       DateTime @default(now())

  round JudgingRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, emailHash])
}
